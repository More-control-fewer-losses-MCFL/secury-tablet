# Copie este arquivo para ".env" e ALTERE as senhas antes de usar.
# Nunca envie o arquivo ".env" para o Git.

MYSQL_DATABASE=armario_tablets
MYSQL_USER=armario
MYSQL_PASSWORD=troque_esta_senha
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=troque_esta_senha_root

# Banco usado pelos testes de integração (use um banco separado!)
# TEST_DATABASE_URL=mysql+pymysql://armario:troque_esta_senha@127.0.0.1:3306/armario_tablets_test

# Código do armário usado no MVP
CABINET_CODE=ARM-01

# Hardware simulado fica LIGADO por padrão. Nunca acione fechadura real em demonstração.
HARDWARE_SIMULATED=true
# Obrigatória inclusive na simulação HTTP. Gere uma chave diferente de ADMIN_TOKEN_SECRET.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# HARDWARE_API_KEY=cole_aqui_uma_chave_aleatoria_com_32_bytes_ou_mais
LOCK_CONFIRM_TIMEOUT_SECONDS=5

# URL da API local (usada pela interface, se necessário)
API_BASE_URL=http://127.0.0.1:8000
# Acesso administrativo: configure uma senha própria e gere a chave com
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=defina_uma_senha_forte_com_12_caracteres_ou_mais
# ADMIN_TOKEN_SECRET=cole_aqui_uma_chave_aleatoria_com_32_bytes_ou_mais
# ADMIN_SESSION_TTL_MINUTES=480
# Origens explícitas permitidas para Flutter Web (sem curingas).
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8502,http://127.0.0.1:8502
LOG_LEVEL=INFO

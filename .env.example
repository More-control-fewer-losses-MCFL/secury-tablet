# Copie este arquivo para ".env" e ALTERE as senhas antes de usar.
# Nunca envie o arquivo ".env" para o Git.

POSTGRES_DB=armario_tablets
POSTGRES_USER=armario
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Banco usado pelos testes de integração (use um banco separado!)
# TEST_DATABASE_URL=postgresql+psycopg://armario:troque_esta_senha@127.0.0.1:5432/armario_tablets_test

# Código do armário usado no MVP
CABINET_CODE=ARM-01

# Hardware simulado fica LIGADO por padrão. Nunca acione fechadura real em demonstração.
HARDWARE_SIMULATED=true
LOCK_CONFIRM_TIMEOUT_SECONDS=5

# URL da API local (usada pela interface, se necessário)
API_BASE_URL=http://127.0.0.1:8000
LOG_LEVEL=INFO
